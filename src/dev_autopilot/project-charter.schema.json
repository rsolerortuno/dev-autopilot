{
  "$defs": {
    "AgentCommand": {
      "additionalProperties": false,
      "properties": {
        "allowed_environment": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Allowed Environment",
          "type": "array"
        },
        "command": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Command",
          "type": "array"
        },
        "estimated_micro_usd": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Estimated Micro Usd"
        },
        "model_name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Model Name"
        },
        "runtime": {
          "default": "local",
          "enum": [
            "local",
            "docker"
          ],
          "title": "Runtime",
          "type": "string"
        },
        "sandbox_image": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sandbox Image"
        },
        "sandbox_network": {
          "default": "none",
          "title": "Sandbox Network",
          "type": "string"
        },
        "timeout_seconds": {
          "default": 3600,
          "exclusiveMinimum": 0,
          "title": "Timeout Seconds",
          "type": "integer"
        }
      },
      "required": [
        "command"
      ],
      "title": "AgentCommand",
      "type": "object"
    },
    "AgentSettings": {
      "additionalProperties": false,
      "properties": {
        "agy": {
          "anyOf": [
            {
              "$ref": "#/$defs/AgentCommand"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "claude_reviewer": {
          "anyOf": [
            {
              "$ref": "#/$defs/AgentCommand"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "claude_supervisor": {
          "anyOf": [
            {
              "$ref": "#/$defs/AgentCommand"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "codex": {
          "anyOf": [
            {
              "$ref": "#/$defs/AgentCommand"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "title": "AgentSettings",
      "type": "object"
    },
    "AutonomyPolicy": {
      "additionalProperties": false,
      "properties": {
        "ambiguity_policy": {
          "const": "safest_reversible_assumption",
          "default": "safest_reversible_assumption",
          "title": "Ambiguity Policy",
          "type": "string"
        },
        "ask_questions": {
          "const": false,
          "default": false,
          "title": "Ask Questions",
          "type": "boolean"
        },
        "destructive_actions": {
          "const": "deny",
          "default": "deny",
          "title": "Destructive Actions",
          "type": "string"
        },
        "human_gate": {
          "const": "release_only",
          "default": "release_only",
          "title": "Human Gate",
          "type": "string"
        },
        "mode": {
          "const": "continuous",
          "default": "continuous",
          "title": "Mode",
          "type": "string"
        },
        "overwrite_policy": {
          "const": "version_outputs",
          "default": "version_outputs",
          "title": "Overwrite Policy",
          "type": "string"
        }
      },
      "title": "AutonomyPolicy",
      "type": "object"
    },
    "BudgetPolicy": {
      "additionalProperties": false,
      "properties": {
        "max_calls": {
          "default": 100,
          "exclusiveMinimum": 0,
          "title": "Max Calls",
          "type": "integer"
        },
        "max_micro_usd": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Micro Usd"
        },
        "project_id": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Project Id"
        },
        "project_max_calls": {
          "default": 1000,
          "exclusiveMinimum": 0,
          "title": "Project Max Calls",
          "type": "integer"
        },
        "project_max_micro_usd": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Project Max Micro Usd"
        }
      },
      "title": "BudgetPolicy",
      "type": "object"
    },
    "EvidencePolicy": {
      "additionalProperties": false,
      "description": "M02/M03 evidence and milestone acceptance policy.",
      "properties": {
        "bundle_directory": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Bundle Directory"
        },
        "enforce_acceptance": {
          "default": true,
          "title": "Enforce Acceptance",
          "type": "boolean"
        },
        "generate_bundle": {
          "default": true,
          "title": "Generate Bundle",
          "type": "boolean"
        },
        "milestone_id": {
          "default": "M05",
          "pattern": "^M\\d{2,}$",
          "title": "Milestone Id",
          "type": "string"
        },
        "required_score": {
          "default": 90,
          "maximum": 100,
          "minimum": 0,
          "title": "Required Score",
          "type": "integer"
        }
      },
      "title": "EvidencePolicy",
      "type": "object"
    },
    "FilePathRule": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "file",
          "title": "Kind",
          "type": "string"
        },
        "path": {
          "title": "Path",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "path"
      ],
      "title": "FilePathRule",
      "type": "object"
    },
    "GatePolicy": {
      "additionalProperties": false,
      "properties": {
        "allow_git_writes": {
          "default": false,
          "title": "Allow Git Writes",
          "type": "boolean"
        },
        "allow_network": {
          "default": false,
          "title": "Allow Network",
          "type": "boolean"
        },
        "max_changed_files": {
          "default": 200,
          "exclusiveMinimum": 0,
          "title": "Max Changed Files",
          "type": "integer"
        },
        "max_context_bytes": {
          "default": 2000000,
          "exclusiveMinimum": 0,
          "title": "Max Context Bytes",
          "type": "integer"
        },
        "require_clean_baseline": {
          "default": false,
          "title": "Require Clean Baseline",
          "type": "boolean"
        },
        "retrieve_context": {
          "default": false,
          "title": "Retrieve Context",
          "type": "boolean"
        }
      },
      "title": "GatePolicy",
      "type": "object"
    },
    "GlobPathRule": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "glob",
          "title": "Kind",
          "type": "string"
        },
        "pattern": {
          "title": "Pattern",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "pattern"
      ],
      "title": "GlobPathRule",
      "type": "object"
    },
    "JobSpecification": {
      "additionalProperties": false,
      "properties": {
        "agents": {
          "$ref": "#/$defs/AgentSettings",
          "default": {
            "agy": null,
            "claude_reviewer": null,
            "claude_supervisor": null,
            "codex": null
          }
        },
        "allowed_paths": {
          "items": {
            "discriminator": {
              "mapping": {
                "file": "#/$defs/FilePathRule",
                "glob": "#/$defs/GlobPathRule",
                "tree": "#/$defs/TreePathRule"
              },
              "propertyName": "kind"
            },
            "oneOf": [
              {
                "$ref": "#/$defs/FilePathRule"
              },
              {
                "$ref": "#/$defs/TreePathRule"
              },
              {
                "$ref": "#/$defs/GlobPathRule"
              }
            ]
          },
          "minItems": 1,
          "title": "Allowed Paths",
          "type": "array"
        },
        "budget": {
          "$ref": "#/$defs/BudgetPolicy",
          "default": {
            "max_calls": 100,
            "max_micro_usd": null,
            "project_id": null,
            "project_max_calls": 1000,
            "project_max_micro_usd": null
          }
        },
        "evidence": {
          "$ref": "#/$defs/EvidencePolicy",
          "default": {
            "bundle_directory": null,
            "enforce_acceptance": true,
            "generate_bundle": true,
            "milestone_id": "M05",
            "required_score": 90
          }
        },
        "gates": {
          "$ref": "#/$defs/GatePolicy",
          "default": {
            "allow_git_writes": false,
            "allow_network": false,
            "max_changed_files": 200,
            "max_context_bytes": 2000000,
            "require_clean_baseline": false,
            "retrieve_context": false
          }
        },
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "objective": {
          "minLength": 1,
          "title": "Objective",
          "type": "string"
        },
        "repository": {
          "minLength": 1,
          "title": "Repository",
          "type": "string"
        },
        "retry_policy": {
          "$ref": "#/$defs/RetryPolicySpec",
          "default": {
            "delays_seconds": [
              1,
              2,
              3,
              4,
              5,
              6,
              7,
              8
            ],
            "jitter_fraction": 0.1,
            "max_attempts": 8
          }
        },
        "review": {
          "$ref": "#/$defs/ReviewPolicy",
          "default": {
            "max_correction_rounds": 3,
            "repair_malformed_output_once": true,
            "require_agy": true
          }
        },
        "scientific_invariants": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Scientific Invariants",
          "type": "array"
        },
        "test_commands": {
          "$ref": "#/$defs/TestCommands"
        }
      },
      "required": [
        "name",
        "objective",
        "repository",
        "allowed_paths",
        "test_commands"
      ],
      "title": "JobSpecification",
      "type": "object"
    },
    "ProjectMilestone": {
      "additionalProperties": false,
      "properties": {
        "dependencies": {
          "default": [],
          "items": {
            "pattern": "^M\\d{2,}$",
            "type": "string"
          },
          "title": "Dependencies",
          "type": "array"
        },
        "job": {
          "$ref": "#/$defs/JobSpecification"
        },
        "milestone_id": {
          "pattern": "^M\\d{2,}$",
          "title": "Milestone Id",
          "type": "string"
        },
        "objective": {
          "minLength": 1,
          "title": "Objective",
          "type": "string"
        },
        "title": {
          "minLength": 1,
          "title": "Title",
          "type": "string"
        }
      },
      "required": [
        "milestone_id",
        "title",
        "objective",
        "job"
      ],
      "title": "ProjectMilestone",
      "type": "object"
    },
    "RetryPolicySpec": {
      "additionalProperties": false,
      "properties": {
        "delays_seconds": {
          "default": [
            1,
            2,
            3,
            4,
            5,
            6,
            7,
            8
          ],
          "items": {
            "type": "integer"
          },
          "title": "Delays Seconds",
          "type": "array"
        },
        "jitter_fraction": {
          "default": 0.1,
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Jitter Fraction",
          "type": "number"
        },
        "max_attempts": {
          "default": 8,
          "exclusiveMinimum": 0,
          "title": "Max Attempts",
          "type": "integer"
        }
      },
      "title": "RetryPolicySpec",
      "type": "object"
    },
    "ReviewPolicy": {
      "additionalProperties": false,
      "properties": {
        "max_correction_rounds": {
          "default": 3,
          "minimum": 0,
          "title": "Max Correction Rounds",
          "type": "integer"
        },
        "repair_malformed_output_once": {
          "default": true,
          "title": "Repair Malformed Output Once",
          "type": "boolean"
        },
        "require_agy": {
          "default": true,
          "title": "Require Agy",
          "type": "boolean"
        }
      },
      "title": "ReviewPolicy",
      "type": "object"
    },
    "TestCommands": {
      "additionalProperties": false,
      "properties": {
        "allow_shell": {
          "default": false,
          "title": "Allow Shell",
          "type": "boolean"
        },
        "baseline": {
          "minLength": 1,
          "title": "Baseline",
          "type": "string"
        },
        "fast": {
          "minLength": 1,
          "title": "Fast",
          "type": "string"
        },
        "final": {
          "minLength": 1,
          "title": "Final",
          "type": "string"
        }
      },
      "required": [
        "baseline",
        "fast",
        "final"
      ],
      "title": "TestCommands",
      "type": "object"
    },
    "TreePathRule": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "tree",
          "title": "Kind",
          "type": "string"
        },
        "path": {
          "title": "Path",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "path"
      ],
      "title": "TreePathRule",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "autonomy": {
      "$ref": "#/$defs/AutonomyPolicy",
      "default": {
        "ambiguity_policy": "safest_reversible_assumption",
        "ask_questions": false,
        "destructive_actions": "deny",
        "human_gate": "release_only",
        "mode": "continuous",
        "overwrite_policy": "version_outputs"
      }
    },
    "definition_of_done": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "minItems": 1,
      "title": "Definition Of Done",
      "type": "array"
    },
    "milestones": {
      "items": {
        "$ref": "#/$defs/ProjectMilestone"
      },
      "minItems": 1,
      "title": "Milestones",
      "type": "array"
    },
    "mission": {
      "minLength": 1,
      "title": "Mission",
      "type": "string"
    },
    "non_goals": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Non Goals",
      "type": "array"
    },
    "project_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
      "title": "Project Id",
      "type": "string"
    },
    "title": {
      "minLength": 1,
      "title": "Title",
      "type": "string"
    }
  },
  "required": [
    "project_id",
    "title",
    "mission",
    "definition_of_done",
    "milestones"
  ],
  "title": "ProjectCharter",
  "type": "object"
}
