{
  "$defs": {
    "AgentCommand": {
      "additionalProperties": false,
      "properties": {
        "command": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Command",
          "type": "array"
        },
        "timeout_seconds": {
          "default": 3600,
          "exclusiveMinimum": 0,
          "title": "Timeout Seconds",
          "type": "integer"
        }
      },
      "required": [
        "command"
      ],
      "title": "AgentCommand",
      "type": "object"
    },
    "AgentSettings": {
      "additionalProperties": false,
      "properties": {
        "agy": {
          "anyOf": [
            {
              "$ref": "#/$defs/AgentCommand"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "claude_reviewer": {
          "anyOf": [
            {
              "$ref": "#/$defs/AgentCommand"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "claude_supervisor": {
          "anyOf": [
            {
              "$ref": "#/$defs/AgentCommand"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "codex": {
          "anyOf": [
            {
              "$ref": "#/$defs/AgentCommand"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "title": "AgentSettings",
      "type": "object"
    },
    "EvidencePolicy": {
      "additionalProperties": false,
      "description": "M02/M03 evidence and milestone acceptance policy.",
      "properties": {
        "bundle_directory": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Bundle Directory"
        },
        "enforce_acceptance": {
          "default": true,
          "title": "Enforce Acceptance",
          "type": "boolean"
        },
        "generate_bundle": {
          "default": true,
          "title": "Generate Bundle",
          "type": "boolean"
        },
        "milestone_id": {
          "default": "M05",
          "pattern": "^M\\d{2,}$",
          "title": "Milestone Id",
          "type": "string"
        },
        "required_score": {
          "default": 90,
          "maximum": 100,
          "minimum": 0,
          "title": "Required Score",
          "type": "integer"
        }
      },
      "title": "EvidencePolicy",
      "type": "object"
    },
    "FilePathRule": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "file",
          "title": "Kind",
          "type": "string"
        },
        "path": {
          "title": "Path",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "path"
      ],
      "title": "FilePathRule",
      "type": "object"
    },
    "GatePolicy": {
      "additionalProperties": false,
      "properties": {
        "allow_git_writes": {
          "default": false,
          "title": "Allow Git Writes",
          "type": "boolean"
        },
        "allow_network": {
          "default": false,
          "title": "Allow Network",
          "type": "boolean"
        },
        "max_changed_files": {
          "default": 200,
          "exclusiveMinimum": 0,
          "title": "Max Changed Files",
          "type": "integer"
        },
        "max_context_bytes": {
          "default": 2000000,
          "exclusiveMinimum": 0,
          "title": "Max Context Bytes",
          "type": "integer"
        },
        "require_clean_baseline": {
          "default": false,
          "title": "Require Clean Baseline",
          "type": "boolean"
        }
      },
      "title": "GatePolicy",
      "type": "object"
    },
    "GlobPathRule": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "glob",
          "title": "Kind",
          "type": "string"
        },
        "pattern": {
          "title": "Pattern",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "pattern"
      ],
      "title": "GlobPathRule",
      "type": "object"
    },
    "RetryPolicySpec": {
      "additionalProperties": false,
      "properties": {
        "delays_seconds": {
          "default": [
            1,
            2,
            3,
            4,
            5,
            6,
            7,
            8
          ],
          "items": {
            "type": "integer"
          },
          "title": "Delays Seconds",
          "type": "array"
        },
        "jitter_fraction": {
          "default": 0.1,
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Jitter Fraction",
          "type": "number"
        },
        "max_attempts": {
          "default": 8,
          "exclusiveMinimum": 0,
          "title": "Max Attempts",
          "type": "integer"
        }
      },
      "title": "RetryPolicySpec",
      "type": "object"
    },
    "ReviewPolicy": {
      "additionalProperties": false,
      "properties": {
        "max_correction_rounds": {
          "default": 3,
          "minimum": 0,
          "title": "Max Correction Rounds",
          "type": "integer"
        },
        "repair_malformed_output_once": {
          "default": true,
          "title": "Repair Malformed Output Once",
          "type": "boolean"
        },
        "require_agy": {
          "default": true,
          "title": "Require Agy",
          "type": "boolean"
        }
      },
      "title": "ReviewPolicy",
      "type": "object"
    },
    "TestCommands": {
      "additionalProperties": false,
      "properties": {
        "allow_shell": {
          "default": false,
          "title": "Allow Shell",
          "type": "boolean"
        },
        "baseline": {
          "minLength": 1,
          "title": "Baseline",
          "type": "string"
        },
        "fast": {
          "minLength": 1,
          "title": "Fast",
          "type": "string"
        },
        "final": {
          "minLength": 1,
          "title": "Final",
          "type": "string"
        }
      },
      "required": [
        "baseline",
        "fast",
        "final"
      ],
      "title": "TestCommands",
      "type": "object"
    },
    "TreePathRule": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "tree",
          "title": "Kind",
          "type": "string"
        },
        "path": {
          "title": "Path",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "path"
      ],
      "title": "TreePathRule",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "agents": {
      "$ref": "#/$defs/AgentSettings",
      "default": {
        "agy": null,
        "claude_reviewer": null,
        "claude_supervisor": null,
        "codex": null
      }
    },
    "allowed_paths": {
      "items": {
        "discriminator": {
          "mapping": {
            "file": "#/$defs/FilePathRule",
            "glob": "#/$defs/GlobPathRule",
            "tree": "#/$defs/TreePathRule"
          },
          "propertyName": "kind"
        },
        "oneOf": [
          {
            "$ref": "#/$defs/FilePathRule"
          },
          {
            "$ref": "#/$defs/TreePathRule"
          },
          {
            "$ref": "#/$defs/GlobPathRule"
          }
        ]
      },
      "minItems": 1,
      "title": "Allowed Paths",
      "type": "array"
    },
    "evidence": {
      "$ref": "#/$defs/EvidencePolicy",
      "default": {
        "bundle_directory": null,
        "enforce_acceptance": true,
        "generate_bundle": true,
        "milestone_id": "M05",
        "required_score": 90
      }
    },
    "gates": {
      "$ref": "#/$defs/GatePolicy",
      "default": {
        "allow_git_writes": false,
        "allow_network": false,
        "max_changed_files": 200,
        "max_context_bytes": 2000000,
        "require_clean_baseline": false
      }
    },
    "name": {
      "minLength": 1,
      "title": "Name",
      "type": "string"
    },
    "objective": {
      "minLength": 1,
      "title": "Objective",
      "type": "string"
    },
    "repository": {
      "minLength": 1,
      "title": "Repository",
      "type": "string"
    },
    "retry_policy": {
      "$ref": "#/$defs/RetryPolicySpec",
      "default": {
        "delays_seconds": [
          1,
          2,
          3,
          4,
          5,
          6,
          7,
          8
        ],
        "jitter_fraction": 0.1,
        "max_attempts": 8
      }
    },
    "review": {
      "$ref": "#/$defs/ReviewPolicy",
      "default": {
        "max_correction_rounds": 3,
        "repair_malformed_output_once": true,
        "require_agy": true
      }
    },
    "scientific_invariants": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Scientific Invariants",
      "type": "array"
    },
    "test_commands": {
      "$ref": "#/$defs/TestCommands"
    }
  },
  "required": [
    "name",
    "objective",
    "repository",
    "allowed_paths",
    "test_commands"
  ],
  "title": "JobSpecification",
  "type": "object"
}
